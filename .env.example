ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
QUALITY_JUDGE_MODEL=claude-sonnet-4-6
QUALITY_REPAIR_MODEL=claude-sonnet-4-6
PHOENIX_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT=travel-agent
# Optional authenticated mirror to Arize AX (separate from Phoenix credentials).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1
QUALITY_WINDOW=20
QUALITY_MIN_SAMPLES=10
QUALITY_THRESHOLD=0.85
QUALITY_BREACH_NEW_SAMPLES=0
QUALITY_ALERT_EMAIL=travel-agent-dev@example.com
QUALITY_SMTP_HOST=127.0.0.1
QUALITY_SMTP_PORT=1025
QUALITY_SMTP_STARTTLS=false
# Real SMTP is optional. Leave these empty for the local SMTP inbox.
QUALITY_SMTP_USERNAME=
QUALITY_SMTP_PASSWORD=
# Optional authenticated GitHub pull_request webhook; never expose without TLS.
QUALITY_GITHUB_WEBHOOK_SECRET=
